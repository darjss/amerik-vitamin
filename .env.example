# Copy to .env and fill in. Owner holds the real values.

# Cloudflare (deploy)=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# PlanetScale Postgres, the one database (prod). Local dev uses DATABASE_URL below=
PLANETSCALE_HOST=
PLANETSCALE_USER=
PLANETSCALE_PASSWORD=
PLANETSCALE_DATABASE=

# Better Auth, Google sign-in=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# QPay=
QPAY_URL=
QPAY_USERNAME=
QPAY_PASSWORD=

# Khaan (khaan-client)=
KHAAN_USERNAME=
KHAAN_PASSWORD=
KHAAN_DEVICE_ID=
KHAAN_USER_AGENT=
KHAAN_ACCOUNT_NUMBER=
KHAAN_BRANCH_CODE=

# tu-delivery=
DELIVERY_API_URL=
DELIVERY_USERNAME=
DELIVERY_PASSWORD=
DELIVERY_SENDERID=

# Telegram admin bot=
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Messenger bot (Zernio + model)=
ZERNIO_API_KEY=
OPENAI_API_KEY=

# SMS gateway (reorder reminders, later)=
SMS_GATEWAY_LOGIN=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_BASE_URL=

# Generated for this repo=
BETTER_AUTH_SECRET=

# Local dev and tests: local Postgres, never prod=
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/amerik
