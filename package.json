{
  "name": "amerik-vitamin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --filter @amerik/infra dev",
    "build": "vp run -r build",
    "check": "vp check",
    "plan": "vp run --filter @amerik/infra plan",
    "deploy": "vp run --filter @amerik/infra deploy",
    "destroy": "vp run --filter @amerik/infra destroy",
    "migrate": "vp run --filter @amerik/db migrate",
    "ready": "vp check && vp run test && vp run -r build",
    "prepare": "vp config && effect-tsgo patch --oxlint",
    "test": "vp run --filter @amerik/api test"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@oxlint/plugins": "catalog:",
    "eslint-plugin-solid": "catalog:",
    "oxlint": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
